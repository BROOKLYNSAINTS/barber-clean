{
  "name": "barber-clean",
  "version": "1.0.1",
  "main": "./App.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "eas-build-pre-install": "node ./eas-build.js",
    "test-user": "node test-user-permissions.cjs",
    "test-firebase": "node test-firebase-config.cjs",
    "test-env": "node test-env.cjs",
    "prestart": "node ./build-support/ts-support.js",
    "generate-stable-config": "node ./generate-stable-config.js",
    "apply-stability-fixes": "npm run generate-stable-config && echo 'Review app.config.stable.js, then rename it to app.config.js'",
    "build-stable-ios": "npm run apply-stability-fixes && eas build -p ios --profile preview",
    "build-stable-android": "npm run apply-stability-fixes && eas build -p android --profile preview"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.1",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-picker/picker": "^2.4.8",
    "@stripe/stripe-react-native": "^0.45.0",
    "axios": "^1.9.0",
    "dotenv": "^16.6.1",
    "expo": "53.0.22",
    "expo-application": "~6.1.5",
    "expo-asset": "~11.1.5",
    "expo-av": "~15.1.7",
    "expo-background-fetch": "^13.1.6",
    "expo-build-properties": "~0.14.8",
    "expo-calendar": "~14.1.4",
    "expo-constants": "^17.1.7",
    "expo-device": "^7.1.4",
    "expo-font": "~13.3.2",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.4",
    "expo-network": "~7.1.5",
    "expo-notifications": "~0.31.2",
    "expo-router": "5.1.6",
    "expo-secure-store": "~14.2.4",
    "expo-speech": "~13.1.7",
    "expo-splash-screen": "~0.30.8",
    "expo-status-bar": "~2.2.3",
    "expo-task-manager": "^13.1.6",
    "expo-updates": "~0.28.17",
    "firebase": "^11.8.1",
    "glob": "^11.0.3",
    "metro": "^0.82.0",
    "metro-config": "^0.82.0",
    "metro-resolver": "^0.82.0",
    "moment": "^2.30.1",
    "node-fetch": "^2.7.0",
    "os-browserify": "^0.3.0",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-calendars": "^1.1312.0",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-voice": "^0.3.0",
    "react-native-webview": "13.13.5",
    "stripe": "^18.5.0",
    "use-latest-callback": "^0.2.3",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@types/react": "~19.0.10",
    "babel-plugin-dotenv-import": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-plugin-transform-typescript-metadata": "^0.3.2",
    "expo": "53.0.22",
    "metro-react-native-babel-preset": "^0.77.0",
    "patch-package": "^8.0.0",
    "react-native-typescript-transformer": "^1.2.13",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3"
  },
  "private": true
}
