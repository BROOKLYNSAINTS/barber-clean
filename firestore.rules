rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Appointments collection
    match /appointments/{appointmentId} {
      // Allow customers to update their own appointments (for cancellation)
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // This rule is important - it allows updating status to 'cancelled'
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.customerId || 
        request.auth.uid == resource.data.barberId
      );
    }
    
    // Users collection (for barbers' availability)
    match /users/{userId} {
      // Base document (profile, availability)
      allow read: if isSignedIn();
      
      // This rule is important - it allows updating barber's availability
      // We need to ensure customers can restore slots when canceling
      allow update: if isSignedIn() && (
        // Allow users to update their own data
        request.auth.uid == userId ||
        // OR allow customers to update availability during cancellation
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availability']) &&
          request.resource.data.availability.diff(resource.data.availability || {}).addedKeys().size() > 0
        )
      );
    }
  }
}
