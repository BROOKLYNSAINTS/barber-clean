// app/_layout.js - Robust TestFlight-compatible implementation
import React, { useEffect, useCallback } from 'react';
import { Stack } from 'expo-router';
import { Text, View, Platform, AppState, LogBox, InteractionManager } from 'react-native';
import * as SplashScreen from 'expo-splash-screen';
import { AuthProvider } from '@/src/contexts/AuthContext';

// CRITICALLY IMPORTANT: Prevent yellow box warnings to ensure smooth initialization
LogBox.ignoreAllLogs();

// CRITICAL: Ensure splash screen doesn't auto-hide
SplashScreen.preventAutoHideAsync()
  .then(() => console.log('✅ Splash screen prevention succeeded'))
  .catch(() => console.log('❌ Splash screen prevention failed'));

console.log('🔄 Root layout loaded - Platform:', Platform.OS, Platform.Version);

export default function RootLayout() {
  // CRITICAL: More robust splash screen hiding function
  const hideSplashScreen = useCallback(async (source) => {
    try {
      console.log(`🔄 Attempting to hide splash screen from ${source}`);
      await SplashScreen.hideAsync();
      console.log('✅ Splash screen hidden successfully');
    } catch (e) {
      console.log('❌ Error hiding splash screen:', e);
      // Try an alternative approach on failure
      setTimeout(() => {
        SplashScreen.hideAsync().catch(() => {});
      }, 200);
    }
  }, []);

  useEffect(() => {
    console.log('📱 Root layout mounted');
    
    // CRITICAL: Multi-layered splash screen hiding strategy
    const timers = [
      setTimeout(() => hideSplashScreen('immediate timer'), 100),
      setTimeout(() => hideSplashScreen('short timer'), 500),
      setTimeout(() => hideSplashScreen('medium timer'), 1000),
      setTimeout(() => hideSplashScreen('long timer'), 2000)
    ];
    
    // CRITICAL: Also try hiding when app state changes
    const appStateSubscription = AppState.addEventListener('change', (nextAppState) => {
      if (nextAppState === 'active') {
        hideSplashScreen('app state change');
      }
    });
    
    // CRITICAL: After all animations and interactions are complete
    InteractionManager.runAfterInteractions(() => {
      hideSplashScreen('interactions complete');
    });
    
    return () => {
      timers.forEach(timer => clearTimeout(timer));
      appStateSubscription.remove();
    };
  }, [hideSplashScreen]);

  // CRITICAL: Use onLayout to hide splash screen when layout is ready
  const onLayoutRootView = useCallback(() => {
    console.log('📐 Root layout rendered');
    hideSplashScreen('layout complete');
  }, [hideSplashScreen]);

  return (
    <AuthProvider>
      <View 
        style={{ flex: 1, backgroundColor: '#ffffff' }}
        onLayout={onLayoutRootView}
      >
        <Stack screenOptions={{ headerShown: false }} />
      </View>
    </AuthProvider>
  );
}
